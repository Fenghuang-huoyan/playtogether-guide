---
import { loadData } from '../lib/content';

interface FaqItem {
  q: string;
  a: string;
  featured?: boolean;
}
interface Props {
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;
const faq = loadData<FaqItem[]>('faq').filter((item) => (featuredOnly ? item.featured : true));
---
<div class="faq-list">
  {faq.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
