---
import { getCollection } from 'astro:content';
import BaseLayout from '@framework/layouts/BaseLayout.astro';
import QuickAnswer from '@framework/components/QuickAnswer.astro';
import AdSlot from '@framework/components/AdSlot.astro';
import FaqList from '@framework/components/FaqList.astro';
import { loadData } from '@framework/lib/content';
import { siteConfig } from '@site/site.config';
import { faqJsonLd, websiteJsonLd } from '@framework/lib/seo';

const meta = loadData<{
  release: string;
  price: string;
  priceNote: string;
  players: string;
  playersNote: string;
  reviews: string;
  reviewsNote: string;
  fish: string;
  fishNote: string;
  platforms: string;
}>('meta');

const faq = loadData<{ q: string; a: string; featured?: boolean }[]>('faq');
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);

const art = {
  header: '/images/official/steam/header.jpg',
  hero: '/images/official/steam/library-hero.jpg',
  capsule: '/images/official/steam/capsule-616x353.jpg',
  creator: '/images/official/steam/ss-00.jpg',
  showcase: '/images/official/steam/ss-01.jpg',
  resort: '/images/official/steam/ss-02.jpg',
  camp: '/images/official/steam/ss-03.jpg',
  pets: '/images/official/steam/ss-04.jpg',
  pier: '/images/official/steam/ss-05.jpg',
  bedroom: '/images/official/steam/ss-06.jpg',
  kart: '/images/official/steam/ss-07.jpg',
  interior: '/images/official/steam/ss-08.jpg',
  plaza: '/images/official/steam/ss-09.jpg',
};

const guideArt: Record<string, string> = {
  codes: art.capsule,
  'beginner-guide': art.creator,
  fishing: art.pier,
  insects: art.camp,
  pets: art.pets,
  money: art.showcase,
  jobs: art.plaza,
  events: art.resort,
  minigames: art.kart,
  homes: art.interior,
  faq: art.header,
  about: art.hero,
};

const doors = [
  {
    href: '/codes',
    num: '01',
    title: 'Codes',
    text: 'Reported coupons, closed official windows, and the Phone path. Verify every string in-game.',
    image: art.capsule,
  },
  {
    href: '/beginner-guide',
    num: '02',
    title: 'First hour',
    text: 'The Phone, the Plaza map, and where the Fishing Shop, Pet Shop, and Camping Ground sit.',
    image: art.creator,
  },
  {
    href: '/fishing',
    num: '03',
    title: 'Fishing',
    text: 'Rod, bait, boat, and why the Illustrated Book is the species list.',
    image: art.pier,
  },
  {
    href: '/insects',
    num: '04',
    title: 'Insects',
    text: 'Bug Nets from Grossard, slow approaches, and what gathering actually collects.',
    image: art.camp,
  },
  {
    href: '/pets',
    num: '05',
    title: 'Pets',
    text: 'Egg, baby, full-grown. Desires, tricks, and the Camping Ground combine NPC.',
    image: art.pets,
  },
  {
    href: '/homes',
    num: '06',
    title: 'Homes',
    text: 'Furniture, home parties, and what the 1.48 notes said about Popular House.',
    image: art.interior,
  },
];

const stills = [
  { src: art.creator, caption: 'Character creator' },
  { src: art.pier, caption: 'The pier' },
  { src: art.pets, caption: 'Pet shop' },
  { src: art.camp, caption: 'Campsite' },
  { src: art.resort, caption: 'Resort pool' },
  { src: art.plaza, caption: 'Plaza fountain' },
  { src: art.kart, caption: 'Go-kart' },
  { src: art.showcase, caption: 'Rides and pets' },
];
---
<BaseLayout
  title={siteConfig.homeTitle}
  description={siteConfig.homeDescription}
  jsonLd={[
    websiteJsonLd(),
    faqJsonLd(faq.filter((item) => item.featured).map((item) => ({ q: item.q, a: item.a }))),
  ]}
>
  <main id="content">
    <div class="shell">
      <p class="tape">
        <span>Fan guide · not affiliated with HAEGIN</span>
        <span>Steam App {siteConfig.steamAppId}</span>
        <span>{siteConfig.version.label}</span>
      </p>

      <section class="town-hero">
        <img
          class="hero-art"
          src={siteConfig.art.hero}
          alt={siteConfig.art.heroAlt}
          width="1920"
          height="620"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-panel">
          <p class="kicker">{siteConfig.developer} · {meta.price} on Steam · released {meta.release}</p>
          <h1>A field guide for Kaia Island.</h1>
          <p class="lede">
            English pages for <em>Play Together</em>: coupons, the first hour, fishing, insects, pets, Stars, and home parties.
            Players join from SEA, Korea, Japan, and everywhere else. The site language stays English.
          </p>
          <div class="cta-row">
            <a class="btn" href="/codes">Codes</a>
            <a class="btn ghost" href="/beginner-guide">First hour</a>
            <a class="btn ghost" href={siteConfig.steamUrl}>View on Steam</a>
          </div>
          <p class="version-note">{siteConfig.version.detail}</p>
        </div>
      </section>
      <p class="art-credit">
        Library hero, capsule, header, and screenshots are official Steam store assets for App {siteConfig.steamAppId}, saved from the store CDN. See the attribution file shipped with the images.
      </p>

      <section class="section">
        <h2>Six doors</h2>
        <p class="section-intro">
          Open the page that matches what you are holding: a coupon, a rod, a net, or a house key. The rest of the guide is the same island, written out.
        </p>
        <div class="door-grid">
          {doors.map((door) => (
            <a class="door" href={door.href}>
              <span class="card-art">
                <img src={door.image} alt="" width="600" height="338" decoding="async" />
                <span class="num">{door.num}</span>
              </span>
              <span class="card-copy">
                <h3>{door.title}</h3>
                <p>{door.text}</p>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" aria-label="Official Steam screenshots">
        <h2>The island, from the store page</h2>
        <p class="section-intro">
          Eight frames from the Steam screenshot set. They show the creator, the pier, the pet shop, and the plaza. They are not a map.
        </p>
        <div class="still-row">
          {stills.map((still) => (
            <figure>
              <img src={still.src} alt="" width="600" height="338" loading="lazy" decoding="async" />
              <figcaption>{still.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="stat-row" aria-label="Steam figures">
        <div class="stat"><strong>{meta.price}</strong><span>{meta.priceNote}</span></div>
        <div class="stat"><strong>{meta.reviews}</strong><span>{meta.reviewsNote}</span></div>
        <div class="stat"><strong>{meta.players}</strong><span>{meta.playersNote}</span></div>
        <div class="stat"><strong>{meta.fish}</strong><span>{meta.fishNote}</span></div>
      </section>

      <section class="section home-quick">
        <QuickAnswer
          sentences={[
            'Play Together is HAEGIN’s free-to-play social game on Steam (AppID 3198850), released 13 January 2025 for Windows and macOS. The store page also lists a mobile link and in-app purchases.',
            'The island loop in HAEGIN’s own words is character customization, home parties, minigames, fishing, insect collecting, fossils, and pets. The Phone at the top right opens the map, friends, missions, and settings.',
            'Coupon codes are entered in the game: Phone, Settings, Enter Coupon. This site lists reported strings and closed official windows. It does not redeem them, and a code can die between checks.',
            'Steam’s store text says the world holds over 600 fish and over 300 insects. The English help articles explain rods, nets, bait, and Desires. They do not publish a full species sheet, so this guide does not invent one.',
          ]}
        />
        <AdSlot name="afterQuickAnswer" />
      </section>

      <section class="section">
        <h2>The pages</h2>
        <p class="section-intro">
          English only. A line from a HAEGIN help article or notice is labeled official. A line from a code tracker is labeled as a report. Verify coupons in the client.
        </p>
        <div class="card-grid">
          {pages.map((page) => (
            <a class="guide-card" href={`/${page.id}`}>
              <span class="card-art">
                <img src={guideArt[page.id] ?? art.header} alt="" width="600" height="338" loading="lazy" decoding="async" />
              </span>
              <span class="card-copy">
                <span class="section-tag">{page.data.section}</span>
                <h3>{page.data.h1}</h3>
                <p>{page.data.description}</p>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="scope">
          <div>
            <h2>What this wiki is for</h2>
            <p>
              The long official write-ups live at {siteConfig.databases.map((db, i) => (
                <>
                  <a href={db.href}>{db.label}</a>
                  {i < siteConfig.databases.length - 1 ? ', ' : ''}
                </>
              ))}. This site is the skim: the first loop, the coupon table, and the systems the help center actually names.
            </p>
            <p>
              Live events and monthly coupons move faster than a static page. If a code or a weekend island looks old, the notice board is the first place to look, then the client.
            </p>
          </div>
          <div>
            <h2>In Steam’s words</h2>
            <p>
              {siteConfig.developer} shipped Play Together on Steam on {meta.release}. The short description calls it a casual social game about customization, homes, and friends. Platforms on the API: {meta.platforms}. The support mail on the store page is {siteConfig.supportEmail}.
            </p>
          </div>
        </div>
      </section>

      <section class="section home-faq">
        <h2>Short answers</h2>
        <FaqList featuredOnly />
        <p><a class="text-link" href="/faq">All FAQ</a></p>
      </section>
    </div>
  </main>
</BaseLayout>
